# Copy to .env.local to override. Defaults are shown.
VITE_AUTH_API_URL=http://localhost:4000/api
VITE_ML_API_URL=http://localhost:5000/api

# Experimental lesion overlay (off by default; see validation/LESIONS.md). Research only.
# VITE_ENABLE_LESION_OVERLAY=true

# The Listen button uses voices built into the device only. Online voices send the result text to a service, so they are OFF unless you set this.
# VITE_ALLOW_NETWORK_VOICES=true

# Spoken Hindi/Kannada uses DRAFT sentences and stays off until a qualified person has reviewed them (docs/SPOKEN_TRANSLATIONS_FOR_REVIEW.md).
# Set this only for a demo or pilot that knowingly reads the drafts; the draft status is announced aloud first.
# A comma-separated list of languages (hi, kn) or true for all. Hindi only:
# VITE_ALLOW_UNREVIEWED_SPEECH=hi
