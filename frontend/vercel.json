{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "rewrites": [
    { "source": "/auth-api/:path*", "destination": "https://endpoint-widen-blinked.ngrok-free.dev/auth-api/:path*" },
    { "source": "/ml-api/:path*", "destination": "https://endpoint-widen-blinked.ngrok-free.dev/ml-api/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/((?!assets/|auth-api/|ml-api/).*)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
  ]
}
