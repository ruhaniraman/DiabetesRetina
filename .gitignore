# Windows default autosave extension
*.asv

# OSX / *nix default autosave extension
*.m~

# Compiled MEX binaries (all platforms)
*.mex*

# Packaged app and toolbox files
*.mlappinstall
*.mltbx

# Generated helpsearch folders
helpsearch*/

# Simulink code generation folders
slprj/
sccprj/

# Matlab code generation folders
codegen/

# Simulink autosave extension
*.autosave

# Simulink cache files
*.slxc

# Octave session info
octave-workspace

# Datasets (too large for Git, kept local only)
data/
!frontend/src/data/

# Large trained models and workspaces
*.mat

# Generated output folders and images
results/
*.png
*.jpg
*.jpeg

# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/

# Secrets / local config (examples are named env.example / .env.example and stay tracked)
.env
.env.local

# Web app assets are source, not generated output (the *.png rule above is for MATLAB result images)
!frontend/src/assets/*.png
!frontend/public/**

# Validation evidence is source, not generated MATLAB output
!validation/results/
!validation/results/**

# Site calibration runs (contain per-image results from a clinic's own data)
calibration/output/

# Raw Grad-CAM maps (135 MB); regenerate with validation/gradcam_eval.py. The summary (gradcam.md/.json) is committed.
validation/results/gradcam_*.mat

# Stage 3 fine-tuning: local manifest has machine-specific paths (splits.csv is the committed record)
stage_3/finetune/manifest.csv

CLAUDE.md

# Review packets, kept local until the clinician and native-speaker reviews (regenerate with docs/tools/)
docs/CLINICAL_REVIEW.md
docs/SPOKEN_TRANSLATIONS_FOR_REVIEW.md
