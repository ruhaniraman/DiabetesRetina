# Copy to .env (never commit it).

# Comma-separated browser origins allowed to call this API.
CLIENT_ORIGINS=http://localhost:5173

# Where the auth-server runs; session tokens are verified against it.
AUTH_SERVER_URL=http://localhost:4000

# Bind address / port. Keep 127.0.0.1 unless a reverse proxy in front adds TLS + auth.
HOST=127.0.0.1
PORT=5000

# Largest accepted image upload, in MB.
MAX_UPLOAD_MB=15

# Set to true to run without MATLAB (Stages 1, 2 and translation still work; Stages 3 and 4 return 503).
DISABLE_MATLAB=false

# Must equal SERVICE_KEY in auth-server/.env. Lets this service save each assessment to the patient's history.
# Leave blank to run without saving history (results are still returned).
SERVICE_KEY=

# --- Production only (see deploy/DEPLOYMENT.md) ---
# APP_ENV=production enforces a strong SERVICE_KEY, https CLIENT_ORIGINS and a non-public HOST at startup,
# and turns the interactive API docs (/docs, /openapi.json) off.
# APP_ENV=production

# The Stage 2 lesion overlay is experimental and OFF by default: validation/LESIONS.md shows it does not detect lesions.
# Enable only for research; the frontend also needs VITE_ENABLE_LESION_OVERLAY=true at build time.
# ENABLE_LESION_OVERLAY=true

# Referral threshold (score at or above which an eye is flagged). Leave unset to use the model's own tuned value (0.20).
# Only set this from a written clinical decision, using the report from calibration/calibrate_site.py (see calibration/README.md).
# Accepted range 0.02 to 0.60; anything else stops the server at startup. Results show whether it came from the model or the site.
# REFERRAL_THRESHOLD=0.36
