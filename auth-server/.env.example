# Copy this file to .env and fill it in. Never commit .env.

PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# Gmail account that SENDS the verification emails.
# Turn on 2-Step Verification, then create an App Password at https://myaccount.google.com/apppasswords
# Leave both blank in development to print the code in the server console instead of emailing it.
# Verify the settings with:  npm run check-email   (add  -- --send  to email yourself a test message)
GMAIL_USER=your.address@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Set to true to only allow users to sign up with @gmail.com addresses.
REQUIRE_GMAIL=false

# Encrypts stored health data (profiles, exam results). Generate once and KEEP IT: losing or changing it makes
# existing data unreadable. Required when NODE_ENV=production.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATA_KEY=replace-with-a-long-random-string

# Shared secret that lets the ML backend record exam results. Must equal SERVICE_KEY in backend/.env.
SERVICE_KEY=replace-with-another-long-random-string
