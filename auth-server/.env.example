# Copy this file to .env and fill it in. Never commit .env.

PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# Sign-up and password reset send a 6-digit code by SMS. No SMS provider is wired in yet: in development the code
# is printed in this server's console.
# Demo/development only: accept this fixed code for every sign-up and password reset and send nothing.
# Anyone can then verify any number or reset any password, so the server refuses to start with it in production.
# FIXED_OTP=123456

# Encrypts stored health data (profiles, exam results). Generate once and KEEP IT: losing or changing it makes
# existing data unreadable. Required when NODE_ENV=production.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATA_KEY=replace-with-a-long-random-string

# Shared secret that lets the ML backend record exam results. Must equal SERVICE_KEY in backend/.env.
SERVICE_KEY=replace-with-another-long-random-string

# --- Production only (see deploy/DEPLOYMENT.md) ---
# Set NODE_ENV=production to enforce strong secrets and an https CLIENT_ORIGIN at startup.
# NODE_ENV=production
# Number of reverse proxies in front of this server (so rate limits use the real client IP). Defaults to 1 in production.
# TRUST_PROXY=1
